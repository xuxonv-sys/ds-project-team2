
# ============================================================
# 1. Credenciales y configuraciones sensibles
# ============================================================

# Directorio de secretos y variables de entorno
.secrets/
.env
.env.*
!.env.example

# Archivos de credenciales y configuraciones locales
credentials.*
database.yaml
conf/local/

# Llaves privadas y certificados
*.pem
*.key

# ============================================================
# 2. Python y uv
# ============================================================

# Entornos virtuales
.venv/
venv/
env/

# Archivos compilados y caché de Python
__pycache__/
*.py[cod]
*.so
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Distribución e instalación de paquetes
build/
dist/
*.egg-info/

# Reportes de cobertura
.coverage
.coverage.*
htmlcov/

# ============================================================
# 3. Jupyter e IPython
# ============================================================

# Checkpoints y archivos temporales de notebooks
.ipynb_checkpoints/
.jupyter_cache/

# Notebooks que deben permanecer locales
*only_local*.ipynb
*local_only*.ipynb

# Historial local de IPython
.ipython/
profile_default/

# ============================================================
# 4. Quarto
# ============================================================

# Caché y archivos internos de Quarto
.quarto/

# Directorios de salida de sitios y presentaciones
_site/
site/
site_libs/

# Recursos generados durante el renderizado
*_files/
*_files/**
_freeze/
*_cache/

# Notebooks temporales generados por Quarto
*.quarto_ipynb

# Archivos intermedios de LaTeX
*.tex

# ============================================================
